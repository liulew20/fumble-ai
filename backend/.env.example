# Copy this file to .env and fill in real values. Never commit .env to git.

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# PostgreSQL connection string (asyncpg driver)
# Local example:  postgresql+asyncpg://user:password@localhost:5432/fumble
# Railway injects this automatically as DATABASE_URL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fumble

# Set to "true" to enable SQLAlchemy query logging (development only)
DEBUG=false
